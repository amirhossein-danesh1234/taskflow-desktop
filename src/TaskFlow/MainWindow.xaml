<Window x:Class="DoktorTasks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoktorTasks"
        mc:Ignorable="d"
        Title="Doktor Tasks - Productivity Dashboard"
        Width="1150" Height="750"
        Background="#0d1320"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#131c2d" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38b2ac" />
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0 0 0 10" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10 6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0 4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0 4" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0 4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Task management dashboard" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Track tasks, XP, recurring work, and achievements" Opacity="0.7" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#b8e1ff" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Sync (placeholder)" Command="{Binding SyncCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- TASK LIST -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 10 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Active tasks" FontSize="16" FontWeight="Bold" Margin="0 0 0 8"/>
                    <DataGrid ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              Background="#0d1320"
                              Foreground="White"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd HH:mm}" Width="*" />
                            <DataGridTextColumn Header="Recurrence" Binding="{Binding RecurrenceTitle}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusTitle}" Width="*" />
                            <DataGridTextColumn Header="XP+" Binding="{Binding XpReward}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0" HorizontalAlignment="Left">
                        <Button Content="Complete selected task" Command="{Binding CompleteTaskCommand}"/>
                        <Button Content="Delete" Click="DeleteTask_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- CREATE TASK -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Add new task" FontSize="16" FontWeight="Bold" Margin="0 0 0 8"/>

                    <Label Content="Task title" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Description" />
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>

                    <Label Content="Category" />
                    <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Due date (optional)" />
                    <DatePicker SelectedDate="{Binding NewDueDate, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Recurrence" />
                    <ComboBox ItemsSource="{Binding RecurrenceOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Title"
                              SelectedValue="{Binding NewRecurrence, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="XP reward" />
                            <TextBox Text="{Binding NewXpReward, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label Content="XP penalty" />
                            <TextBox Text="{Binding NewXpPenalty, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Bonus" />
                            <TextBox Text="{Binding NewBonus, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Label Content="Initial status" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Title"
                              SelectedValue="{Binding NewStatus, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Add task" Command="{Binding AddTaskCommand}" Margin="0 10 0 0" Background="{StaticResource AccentBrush}" Foreground="Black" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PROGRESS -->
            <Border Style="{StaticResource CardStyle}" Margin="0 10 10 0">
                <StackPanel>
                    <TextBlock Text="Progress" FontSize="16" FontWeight="Bold" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="14" />
                    <ProgressBar Minimum="0" Maximum="{Binding NextLevelXp, Mode=OneWay}" Value="{Binding CurrentLevelXp, Mode=OneWay}" Height="16" Margin="0 8 0 0"/>
                    <TextBlock Text="XP threshold per level: 100 points." FontSize="11" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                        <CheckBox Content="Run on Windows startup" IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" Command="{Binding ToggleAutoStartCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- HISTORY -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0 10 10 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent history" FontSize="16" FontWeight="Bold" Margin="0 0 0 8"/>
                    <ListBox ItemsSource="{Binding HistoryEntries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Task.Title}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CompletionDate, StringFormat=yyyy/MM/dd HH:mm}" FontSize="11" Opacity="0.8"/>
                                    <TextBlock Text="{Binding XpGained, StringFormat=XP {0}}" FontSize="11" Foreground="#8be9fd"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ACHIEVEMENTS -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0 10 0 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Achievements" FontSize="16" FontWeight="Bold" Margin="0 0 0 8"/>
                    <ListBox ItemsSource="{Binding Achievements}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding IsUnlocked, Converter={StaticResource BoolToBrushConverter}}" Margin="4"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" />
                                        <TextBlock Text="{Binding TargetValue, StringFormat=Target: {0} XP}" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding UnlockedDate, StringFormat=Unlocked: yyyy/MM/dd}" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
